{
  "info": { "name": "pocket-coach-app-main API", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" },
  "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
  "variable": [
    { "key": "baseUrl", "value": "https://your-api.example.com", "type": "string" },
    { "key": "token", "value": "PASTE_YOUR_BEARER_TOKEN_HERE", "type": "string" }
  ],
  "item": [
    { "name": "chat", "item": [
      { "name": "GET  /chat/conversations", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/chat/conversations", "host": ["{{baseUrl}}"], "path": ["chat","conversations"] } } },
      { "name": "GET  /chat/conversations/{id}", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/chat/conversations/:id", "host": ["{{baseUrl}}"], "path": ["chat","conversations",":id"], "variable": [{ "key": "id", "value": "" }] } } },
      { "name": "DELETE  /chat/conversations/{id}", "request": { "method": "DELETE", "header": [], "url": { "raw": "{{baseUrl}}/chat/conversations/:id", "host": ["{{baseUrl}}"], "path": ["chat","conversations",":id"], "variable": [{ "key": "id", "value": "" }] } } },
      { "name": "POST  /chat/conversations", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": { "raw": "{{baseUrl}}/chat/conversations", "host": ["{{baseUrl}}"], "path": ["chat","conversations"] }, "body": { "mode": "raw", "raw": "{}", "options": { "raw": { "language": "json" } } } } }
    ]},
    { "name": "feed", "item": [
      { "name": "GET  /feed", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/feed", "host": ["{{baseUrl}}"], "path": ["feed"] } } }
    ]}
  ]
}
